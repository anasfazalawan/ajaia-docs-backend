# ==============================================================================
# Ajaia Docs Backend Configuration (.env.example)
# ==============================================================================

# --- Supabase Postgres Connection Strings ---
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Transaction pooler (Port 6543) - used for regular queries with pgbouncer
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler or direct connection (Port 5432) - used for Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Auth & API Configuration ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# JWT Secret is used to verify session tokens issued by Supabase Auth (OAuth/Email)
# Pinned to HS256 algorithm verification to prevent confusion attacks.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- Application Server Settings ---
PORT=4000
# Comma-separated list of allowed frontend origins (no trailing slash) for CORS
FRONTEND_URL="http://localhost:3000"

# --- Realtime Collaboration Server (Hocuspocus + Yjs) ---
COLLAB_PORT=1234
